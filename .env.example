# ── Portal Auto-Upvote ─────────────────────────────────────────────
# Required: 32-byte AES key for encrypting the session private key at rest.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_KEY_ENCRYPTION_KEY=

# The AGW smart account address that owns the upvote session key.
# Default matches the Mantis Pro operator wallet.
AGW_ADDRESS=0x9d60f5906d43aa12b0496765ec202bf498e9cd1f

# mainnet | testnet
# On mainnet the upvote contract must be whitelisted in the Session Key Policy
# Registry (0xA146c7118A46b32aBD0e1ACA41DF4e61061b6b93) before session keys work.
PORTAL_UPVOTE_NETWORK=mainnet

# Optional: override the Node wallet-helper port (default 3456)
WALLET_HELPER_PORT=3456

# ── Existing keys (already set in Railway) ─────────────────────────
ANTHROPIC_API_KEY=
OPENSEA_API_KEY=
WALLET_ADDRESS=
OWNER_PRIVATE_KEY=
CREATOR_PRIVATE_KEY=
